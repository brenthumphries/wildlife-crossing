# Godot 4
.godot/
*.tmp
*.translation
# NOTE: export_presets.cfg is intentionally tracked (B7): our presets hold no
# signing credentials. Re-ignore it if identities/keys are ever added.

# Builds (use GitHub Releases instead)
builds/

# Local Godot binary used for running tests (not committed)
/tools/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Obsidian local config
obsidian-vault/.obsidian/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Generic Godot project-builder toolkit — lives here for convenience,
# not part of the game. Extract to its own repo before tracking it.
/fable-game-builder/

# Obsidian local UI state (pane layout, graph view) — machine-specific churn.
# app/appearance/core-plugins stay tracked so config is shared.
.obsidian/workspace.json
.obsidian/graph.json
