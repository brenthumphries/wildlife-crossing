# Godot 4
.godot/
*.tmp
*.translation
# NOTE: export_presets.cfg is intentionally tracked (B7): our presets hold no
# signing credentials. Re-ignore it if identities/keys are ever added.

# Builds (use GitHub Releases instead)
builds/
# Artifacts downloaded from a CI run land here; same policy as builds/.
/wildlife-crossing-desktop-builds/

# Local Godot binary used for running tests (not committed).
# Ignore the *contents* of tools/ rather than the directory itself, so the
# committed CI scripts below can be re-included — git cannot re-include a file
# whose parent directory is excluded.
/tools/*
!/tools/*.py
!/tools/*.sh
# Same trick one level down: re-include the tests directory itself before its
# contents, or `/tools/*` keeps them out and CI's `unittest discover` finds an
# empty suite that passes vacuously.
!/tools/tests/
!/tools/tests/*.py

# Commit plans consumed by tools/ship.py are per-session scratch. They must be
# ignored rather than merely untracked: ship.py refuses to run when a changed
# path is unaccounted for, and the plan file sitting in the repo would be one.
/commit-plan*.json

# Python bytecode. Must come after the /tools/ re-includes above: re-including
# /tools/tests/ exposes everything inside it, __pycache__ included, and later
# rules win.
__pycache__/
*.pyc

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Obsidian local config
obsidian-vault/.obsidian/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Generic Godot project-builder toolkit — lives here for convenience,
# not part of the game. Extract to its own repo before tracking it.
/fable-game-builder/

# Obsidian local UI state (pane layout, graph view) — machine-specific churn.
# app/appearance/core-plugins stay tracked so config is shared.
.obsidian/workspace.json
.obsidian/graph.json
