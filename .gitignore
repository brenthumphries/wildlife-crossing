# Godot 4
.godot/
*.tmp
*.translation
# NOTE: export_presets.cfg is intentionally tracked (B7): our presets hold no
# signing credentials. If identities or keys are ever added, adding an ignore
# rule here is NOT enough and is not the first thing to try — the file is
# tracked, and CI's export job needs it. See the "Part A pre-flight" section of
# docs/signing-runbook.md, which is where an operator doing A5 will read it.

# Builds (use GitHub Releases instead)
builds/
# Artifacts downloaded from a CI run land here; same policy as builds/.
/wildlife-crossing-desktop-builds/

# Local Godot binary used for running tests (not committed).
# Ignore the *contents* of tools/ rather than the directory itself, so the
# committed CI scripts below can be re-included — git cannot re-include a file
# whose parent directory is excluded.
/tools/*
!/tools/*.py
!/tools/*.sh
# GDScript measurement harnesses run via `godot -s` (measure_tutorial.gd). The
# Godot binary itself lives at tools/godot/ and stays ignored — this pattern
# only re-includes files directly in tools/, and none of them is the engine.
!/tools/*.gd
# Same trick one level down: re-include the tests directory itself before its
# contents, or `/tools/*` keeps them out and CI's `unittest discover` finds an
# empty suite that passes vacuously.
!/tools/tests/
!/tools/tests/*.py

# Commit plans consumed by tools/ship.py are per-session scratch. They must be
# ignored rather than merely untracked: ship.py refuses to run when a changed
# path is unaccounted for, and the plan file sitting in the repo would be one.
/commit-plan*.json

# Credentials. Never commit any of these.
#
# Placed after the /tools/ re-includes above deliberately: this file's own rule
# is that later rules win, and nothing here should ever be re-included by an
# earlier negation.
#
# The trigger is signing-runbook A4. Apple lets the App Store Connect .p8 be
# downloaded exactly once, so a key that leaks is rotated, not recovered, and
# the repository has been public since 2026-08-29. This is the control that
# does not depend on any GitHub-side setting being on.
#
# *.asc is deliberately absent: the GPG *public* key is tracked at
# wildlife-crossing-signing-key.asc and has to stay tracked.
*.p8
*.p12
*.cer
*.pem
*.key
*.mobileprovision
.env

# Python bytecode. Must come after the /tools/ re-includes above: re-including
# /tools/tests/ exposes everything inside it, __pycache__ included, and later
# rules win.
__pycache__/
*.pyc

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Obsidian local config
obsidian-vault/.obsidian/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Generic Godot project-builder toolkit — lives here for convenience,
# not part of the game. Extract to its own repo before tracking it.
/fable-game-builder/

# Obsidian local UI state (pane layout, graph view) — machine-specific churn.
# app/appearance/core-plugins stay tracked so config is shared.
.obsidian/workspace.json
.obsidian/graph.json

# GUT's JUnit output, written by every local suite run and by CI.
# tools/suite_figures.py reads it; nothing should track it.
game/gut_results.xml

# Parking for files awaiting deletion. Sessions running against a
# mounted copy of this repo cannot delete files (the bridge permits
# rename but not unlink), so anything on its way out is moved here and
# removed by hand later. tools/_to_delete/ has predated this entry.
_to_delete/
